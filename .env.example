# Copy this file to .env and fill in your own values. Never share .env or paste keys in chat.
# testnet = Delta India demo account (paper trading). live = real money (also needs allow_live: true in settings.yaml).
DELTA_ENV=testnet

# API key created INSIDE the account that matches DELTA_ENV (demo keys only work on testnet).
# Permissions: trading only. No withdrawals. Whitelist the IP the bot runs from.
DELTA_API_KEY=
DELTA_API_SECRET=

# Optional Telegram alerts (create a bot with @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
